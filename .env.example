# ==========================================
# AMR Home Solutions - Sublet Platform
# Production Environment Variables
# ==========================================
# Copy this to .env.local and fill in values
# NEVER commit .env.local to git

# --- App ---
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database ---
# Development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — uncomment and set:
# DATABASE_URL="postgresql://user:password@host:5432/sublet?schema=public"

# --- AI (Groq) ---
# Free API key at https://console.groq.com/keys (no credit card needed)
GROQ_API_KEY=

# --- Email (SMTP) ---
# Use free tier of Brevo, Resend, or Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@amrhomesolutions.com

# --- WhatsApp (Meta Cloud API) ---
# Free tier: 1,000 conversations/month
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ADMIN_PHONE=

# --- Cloudflare R2 (Image Storage) ---
# Free tier: 10GB storage, 1M reads/month
# Setup: https://developers.cloudflare.com/r2/get-started/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# --- Sentry (Error Monitoring) ---
# Free tier: 5,000 errors/month
# Setup: https://sentry.io/
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_DSN=

# --- Logging ---
LOG_LEVEL=info

# --- Cron Notifications ---
# Shared secret for cron endpoint authentication
CRON_SECRET=
