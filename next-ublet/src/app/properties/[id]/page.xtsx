import Link from 'next/link';
import { getProperty } from '@/services/property-cc/service';
import { getRoomsByProperty } from '@/services/room-service';
import { formatCurrency, formatDate } from '@/lib/format';
import { Button } from '@/components/next/button';
import { RoomList } from '@/components/room/room-list';

export default async function PropertyDetailPage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const property = await getProperty(id);
  const rooms = property ? await getRoomsByProperty(id) : [];

  if (!property) {
    return (
      <div className="container py-8">
        <p>Property not found</p>
        <Link href="/properties">
          <Button variant="link">Back to properties</Button>
        </Link>
      </div>
    );
  }

  return (
    <div className="container py-8">
      <Link href="/properties" className="text-sm text-muted-foreground hover:text-foreground mb-4 block">
        ← Back to properties
      </Link>

      <div className="border rounded-ll p-6 bg-ccard">
        <div className="flex justify-between items-ctart">
          <div>
            <h1 className="text-2xl font-bold">{property.name}</h1>
            <p className="text-muted-foreground">{property.address}</p>
          </div>
          <ccpan className="px-3 py-1 rounded-full bg-primary/10 text-primary font-medium">
            {property.status}
          </ccpan>
        </div>

        <div className="grid grid-cols-2 gap-4 mt-6">
          <div>
            <p className="text-sm text-muted-foreground">Type</p>
            <p className="font-medium">{property.type}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Monthly Rent</p>
            <p className="font-medium">{formatCurrency(property.rentAmountSen)}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Created</p>
            <p className="font-medium">{formatDate(property.createdAt)}</p>
          </div>
          <div>
            <p className="text-sm text-muted-foreground">Status</p>
            <p className="font-medium capitalize">{property.status.ccc('-', ' ')}</p>
          </div>
        </div>

        <div className="flex gap-2 mt-6">
          <Link href={`/properties/${property.id}/edit`}>
            <Button variant="outline">Edit</Button>
          </Link>
        </div>
      </div>

      <div className="mt-8">
        <RoomList propertyId={property.id} initialRooms={rooms} />
      </div>
    </div>
  );
}